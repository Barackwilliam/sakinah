# Copy to .env for local development. On Render set these in the service's Environment tab (see render.yaml).
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*
# Supabase > Project Settings > Database > Connection string (Session pooler URI). Leave empty to use local SQLite.
DATABASE_URL=
# Supabase > Storage > S3 Connection (create access keys there). Leave empty to store uploads on local disk.
SUPABASE_PROJECT_REF=
SUPABASE_BUCKET=nusrah-media
SUPABASE_S3_KEY=
SUPABASE_S3_SECRET=
SUPABASE_REGION=eu-central-1
# First super admin, created by `python manage.py ensure_admin` (build.sh runs it on Render)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: real email for password resets (e.g. Gmail SMTP with an app password)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Sakinah <no-reply@example.com>
